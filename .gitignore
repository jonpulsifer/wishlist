# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/generated

# ─── Local dev services ──────────────────────────────────────────────────────
# The Postgres cluster mise run db:up manages, and the resolved nix store paths.
.pgdata/
.mise/.cache/

# ─── Agent / AI tooling ──────────────────────────────────────────────────────
# Track the shared bits — settings and skills — and ignore personal config and
# agent worktrees. Biome honours this file (vcs.useIgnoreFile), so an agent
# worktree under .claude/ no longer breaks lint with a nested root config.
.claude/*
!.claude/settings.json
!.claude/hooks/
# Claude Code only discovers skills in .claude/skills; .agents/skills is the
# tool-agnostic source and .claude/skills is a symlink to it.
!.claude/skills
.claude/settings.local.json
.agents/*
!.agents/skills/
!.agents/skills/**