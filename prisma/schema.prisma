// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "generated"
  moduleFormat = "esm"
}

// Connection URLs live in prisma.config.ts (CLI) and lib/db/client.ts (runtime
// adapter) — v7 does not accept them here.
datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                        String                   @id @default(uuid()) @db.Uuid
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  name                      String?
  address                   String?
  email                     String                   @unique
  emailVerified             DateTime?
  image                     String?
  pant_size                 String?
  shirt_size                String?
  shoe_size                 String?
  hasCompletedOnboarding    Boolean                  @default(false)
  wishes                    Wish[]                   @relation("WishSubject")
  claimers                  Claimer[]
  proposedWishes            Wish[]                   @relation("WishProposer")
  memberships               Membership[]
  accounts                  Account[]
  sessions                  Session[]
  organisedExchanges        Exchange[]               @relation("Organiser")
  participations            Participant[]
  assignedTo                Participant[]            @relation("AssignedTo")
  assignedBy                Participant[]            @relation("AssignedBy")
  /// Symmetric by construction: creating one connects both directions, so the
  /// Draw sees the pair whichever side it reads.
  excludes                  User[]                   @relation("Exclusions")
  excludedBy                User[]                   @relation("Exclusions")
  createdInvites            Invite[]                 @relation("InvitesCreatedBy")
  redeemedInvites           Invite[]                 @relation("InvitesRedeemedBy")
}

/// A thing one person would like to receive from another. Its **subject** is
/// who would receive it; its **proposer** is who added it. They are usually the
/// same person; when they differ the Wish is a Suggestion, which is what makes
/// surprises possible. `proposerId` is required, so that state is exactly
/// `proposerId != subjectId` with no third case for a reader to forget — a Wish
/// nobody else proposed names its own subject rather than naming nobody.
model Wish {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String    @db.VarChar(255)
  url         String?
  description String?
  archived    Boolean   @default(false)
  /// How many of the thing its subject wants. Five pairs of socks is one Wish
  /// wanted five times, not five Wishes, and it is what lets a Claim speak for
  /// part of a Wish rather than all of it.
  quantity    Int       @default(1)
  subject     User      @relation("WishSubject", fields: [subjectId], references: [id])
  subjectId   String    @db.Uuid
  proposer    User      @relation("WishProposer", fields: [proposerId], references: [id])
  proposerId  String    @db.Uuid
  claimers    Claimer[]

  @@index([createdAt])
  @@index([subjectId, createdAt])
  @@index([proposerId, createdAt])
  @@index([archived])
}

/// A Claim has no field of its own: it is the set of people committed to a
/// Wish, one row per person (ADR-0003). Named `Claimer` and not `Claim`
/// deliberately — a row-per-person called `Claim` would say a Wish has
/// several, which is the thing claiming exists to prevent.
model Claimer {
  wishId    String   @db.Uuid
  userId    String   @db.Uuid
  /// How many of the Wish this person speaks for. Several people going in on
  /// one thing is several rows; the sum against `Wish.quantity` is what "is
  /// this taken?" means.
  quantity  Int      @default(1)
  /// Orders the split: who started it, and who joined.
  createdAt DateTime @default(now())
  wish      Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([wishId, userId])
  @@index([userId])
}

/// The group people share, and the only visibility boundary there is
/// (ADR-0001). `name` is a label: nothing looks a Family up by it, because an
/// Invite is the only way in, so two families may share a name.
model Family {
  id          String           @id @default(uuid()) @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  name        String
  memberships Membership[]
  exchanges   Exchange[]
  invites     Invite[]

  @@index([createdAt])
}

/// Membership is the app's only visibility edge, and it is explicit rather than
/// an implicit many-to-many so that the columns have names — a join table whose
/// columns are `A` and `B` inverts silently if a migration reads them the wrong
/// way round. `joinedAt` is unread; it is here because an edge this load-bearing
/// is worth knowing the date of.
model Membership {
  familyId String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([familyId, userId])
  @@index([userId])
}

/// A bearer link that grants membership of one Family, and the only door into
/// one (ADR-0005).
///
/// Single-use, revocable and expiring, because following one is the only
/// irreversible act in the model: a link that never dies is a standing grant of
/// it, and a forwarded one would cost a group chat's worth of wrong members
/// rather than a single person. Redemption is recorded on the token itself —
/// spent, it is dead.
model Invite {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  token        String    @unique
  familyId     String    @db.Uuid
  family       Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdById  String?   @db.Uuid
  createdBy    User?     @relation("InvitesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  revokedAt    DateTime?
  redeemedAt   DateTime?
  redeemedById String?   @db.Uuid
  redeemedBy   User?     @relation("InvitesRedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([token])
}

/// A round of giving one Family holds for one Occasion.
///
/// The Family bound is not bookkeeping: a Family is the only visibility edge
/// there is, so participants drawn from two of them could be paired into an
/// obligation the visibility rules make impossible to fulfil (ADR-0001). An
/// Exchange grants no visibility of its own; being bound to a Family is what
/// keeps a santa able to see their recipient's Wishes.
model Exchange {
  id   String @id @default(uuid()) @db.Uuid
  name String
  /// The Occasion year this Exchange is held for, which is not always the year
  /// it was opened in — one drawn on January 2nd is still for the Christmas
  /// just gone.
  year Int

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organiser    User          @relation("Organiser", fields: [organiserId], references: [id])
  organiserId  String        @db.Uuid
  family       Family        @relation(fields: [familyId], references: [id])
  familyId     String        @db.Uuid
  participants Participant[]
}

model Participant {
  id           String   @id @default(uuid()) @db.Uuid
  exchange     Exchange @relation(fields: [exchangeId], references: [id])
  exchangeId   String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @db.Uuid
  assignedTo   User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?  @db.Uuid
  assignedBy   User?    @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedById String?  @db.Uuid

  @@unique([exchangeId, userId])
}
