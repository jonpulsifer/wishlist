# Copied to .env by `mise run setup`. The defaults below match the local
# Postgres that `mise run db:up` manages, so only the two Google values need
# filling in by hand.

# ─── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL is the app's driver adapter (lib/db/client.ts); DIRECT_URL is the
# Prisma CLI (prisma.config.ts). On a hosted Postgres they differ — the CLI must
# not go through a pooler. Locally they are the same.
#
# A hosted URL needs `sslmode=require`. The adapter is node-postgres, which
# connects in plaintext unless the URL says otherwise, and a provider that
# demands TLS answers with SQLSTATE 28000 — which Prisma renders as "User was
# denied access on the database `(not available)`", naming neither.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wishlist
DIRECT_URL=postgres://postgres:postgres@localhost:5432/wishlist

# Scratch database Migrate replays the migration chain into, so that
# `migrate diff --from-migrations` can prove the history and schema.prisma
# agree. Local only — `migrate deploy` never uses one, so leave it unset in
# production. `mise run db:up` creates it.
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wishlist_shadow

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required. Auth.js refuses to start without it — there is no dev fallback.
# `mise run setup` generates one when it writes .env; otherwise:
#   bun -e 'console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString("base64"))'
AUTH_SECRET=

# Google is the only sign-in provider (app/auth.ts). Create an OAuth client at
# console.cloud.google.com → APIs & Services → Credentials, and add
# http://localhost:3000/api/auth/callback/google as an authorised redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Gift recommendations (lib/ai.ts, /ai and /api/recommendations). Unset, the
# rest of the app works and those surfaces fail.
OPENAI_API_KEY=

# Self-hosting only. Auth.js trusts the request host in development and on
# Vercel; behind any other proxy it needs telling. The Dockerfile is the only
# path here — Vercel sets VERCEL itself.
# AUTH_TRUST_HOST=true
